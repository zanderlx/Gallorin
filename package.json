{
  "name": "gallorin-horse-sanctuary",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Gallorin: a local fantasy horse collection game with data-driven spawning.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "import:references": "node scripts/import-references.js",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --config electron-builder.json --dir",
    "desktop:build": "electron-builder --config electron-builder.json --win --publish never",
    "release:check": "node scripts/release-notes.js --check",
    "release:notes": "node scripts/release-notes.js --write",
    "release:draft": "node scripts/release-notes.js --draft"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "music-metadata": "12.2.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.js",
  "author": "Gallorin",
  "repository": {
    "url": "https://github.com/zanderlx/Gallorin.git",
    "type": "git"
  }
}
